# Configurações do Servidor Fastify
PORTA_API=3000
HOST_API=0.0.0.0

# Domínio DuckDNS e Portas (VPS / Produção)
DOMINIO_DUCKDNS=mdm-corporativo.duckdns.org
HTTPS_PORT=443
MQTT_PORT=1883

# Banco de Dados PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=sua_senha_postgres_aqui
PG_DATABASE=mdm_corporativo

# Broker MQTT (Mosquitto MQTTS)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=

# Segurança e Autenticação Web & Dispositivos
JWT_SECRET=seu_segredo_jwt_super_seguro_producao_gerado_com_openssl
ADMIN_EMAIL=admin@mdm.corporativo
ADMIN_SENHA=SuaSenhaForteAqui123!
DEVICE_API_KEY=sua_chave_secreta_de_dispositivos
